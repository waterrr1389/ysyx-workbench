[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 24
cover: mode cover
cover: depth 24
prove: mode prove
prove: depth 16

[engines]
smtbmc yices

[script]
read -formal LFSR.v
read -formal IFU.v
read -formal ifu_axil.sv
# Read last: they set `default_nettype none for the files after them.
read -formal faxil_master.v
prep -top ifu_axil

[files]
../vsrc/utils/LFSR.v
build/IFU.v
ifu_axil.sv
vendor/faxil_master.v
