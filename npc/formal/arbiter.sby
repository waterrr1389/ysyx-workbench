[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 24
cover: mode cover
cover: depth 24
prove: mode prove
prove: depth 16

[engines]
smtbmc yices

[script]
read -formal Arbiter.v
read -formal arbiter_axil.sv
# Read last: they set `default_nettype none for the files after them.
read -formal faxil_slave.v
read -formal faxil_master.v
prep -top arbiter_axil

[files]
build/Arbiter.v
arbiter_axil.sv
vendor/faxil_slave.v
vendor/faxil_master.v
