menu "ISA-dependent Options for riscv"

config RV64
  bool "64-bit RISC-V architecture"
  default n

config RVE
  bool "Use E extension"
  default n

config RISCV_HIERARCHICAL_DECODE
  bool "Use hierarchical instruction decoder"
  depends on !RV64
  default n
  help
    Use the optimized opcode-grouped decoder. Keep this disabled to use the
    INSTPAT decoder, which is the default implementation for ISA development.
endmenu
