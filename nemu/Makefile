# Sanity check
ifeq ($(wildcard $(NEMU_HOME)/src/nemu-main.c),)
  $(error NEMU_HOME=$(NEMU_HOME) is not a NEMU repo)
endif

# NEMU is compiled by Meson (meson.build). This Makefile keeps the menuconfig
# rules and the run/gdb entry points that AM's `make run` calls.

# Include variables and rules generated by menuconfig
-include $(NEMU_HOME)/include/config/auto.conf
-include $(NEMU_HOME)/include/config/auto.conf.cmd

remove_quote = $(patsubst "%",%,$(1))

# Extract variabls from menuconfig
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
ENGINE ?= $(call remove_quote,$(CONFIG_ENGINE))
NAME    = $(GUEST_ISA)-nemu-$(ENGINE)

# Include rules for menuconfig
include $(NEMU_HOME)/scripts/config.mk

# git_commit, for the tracer-ysyx branch
-include $(NEMU_HOME)/../Makefile

BUILD_DIR = $(abspath $(NEMU_HOME)/../build-nemu)
BINARY    = $(BUILD_DIR)/$(NAME)$(if $(CONFIG_TARGET_SHARE),.so,)
# meson.build stops if the build directory's compiler differs from CONFIG_CC.
MESON_CC  = $(call remove_quote,$(CONFIG_CC))
MESON_CXX = $(if $(filter clang,$(MESON_CC)),clang++,g++)

.DEFAULT_GOAL = app

$(BUILD_DIR)/build.ninja:
	CC="ccache $(MESON_CC)" CXX="ccache $(MESON_CXX)" meson setup $(BUILD_DIR) $(NEMU_HOME)

# Ninja decides what is stale; it also makes the "compile NEMU" tracer commit.
app: $(BUILD_DIR)/build.ninja
	@ninja -C $(BUILD_DIR)

include $(NEMU_HOME)/tools/difftest.mk

override ARGS ?= --log=$(BUILD_DIR)/nemu-log.txt
override ARGS += $(ARGS_DIFF)

IMG ?=
NEMU_EXEC := $(BINARY) $(ARGS) $(IMG)

run-env: app $(DIFF_REF_SO)

run: run-env
	$(call git_commit, "run NEMU")
	$(NEMU_EXEC)

gdb: run-env
	$(call git_commit, "gdb NEMU")
	gdb -s $(BINARY) --args $(NEMU_EXEC)

clean:
	-rm -rf $(BUILD_DIR)

clean-tools = $(dir $(shell find ./tools -maxdepth 2 -mindepth 2 -name "Makefile"))
$(clean-tools):
	-@$(MAKE) -s -C $@ clean
clean-tools: $(clean-tools)
clean-all: clean distclean clean-tools

.PHONY: app run gdb run-env clean clean-tools clean-all $(clean-tools)
